// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/src"],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"hidden": false,
				"group": "tasks",
				"order": 1
			}
		},
		{
			"type": "node",
			"name": "Jest get_ranked_tags",
			"request": "launch",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["test", "tjl/repomap/repomap/RepoMap.test.ts", "-t", "get_ranked_tags"],
			"cwd": "${workspaceFolder}/src",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"disableOptimisticBPs": true
		},
		{
			"type": "node",
			"name": "Jest grep_ast",
			"request": "launch",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["test", "tjl/repomap/grep_ast/treeCtx.test.ts", "-t", "test grep_ast"],
			"cwd": "${workspaceFolder}/src",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"disableOptimisticBPs": true
		},
		{
			"type": "node",
			"name": "Jest get_repo_map",
			"request": "launch",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["test", "tjl/repomap/repomap/RepoMap.test.ts", "-t", "get_repo_map"],
			"cwd": "${workspaceFolder}/src",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"disableOptimisticBPs": true
		}
	]
}
